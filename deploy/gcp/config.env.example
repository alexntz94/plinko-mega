# Google Cloud deployment settings. Copy to deploy/gcp/config.env (never committed) and fill in.
# No secrets here: deploy.sh creates them straight in Secret Manager.

# Your project and region (pick one close to the players; the PAM's region is a good choice).
PROJECT_ID=my-plinko-project
REGION=europe-west1

# The game's public address. Point its DNS A record at the IP that deploy.sh prints.
GAME_DOMAIN=plinko.example.com

# Google accounts allowed to reach the admin panel (comma-separated). They still need their admin login and 2FA.
ADMIN_EMAILS=you@example.com
ADMIN_USERNAME=admin

# Wallet (PAM) address; must be https://. Its key and secret are asked for by "deploy.sh secrets".
PAM_BASE_URL=https://pam.example.com/wallet
# Optional: the PAM's IP ranges (comma-separated), so the services can connect out to nothing else on port 443.
# PAM_EGRESS_RANGES=203.0.113.0/24

# Cloud SQL size (1 vCPU / 3.75 GB). REGIONAL keeps a standby in a second zone (about twice the price).
# A small casino or staging: DB_AVAILABILITY=ZONAL (and GAME_MAX_INSTANCES=3).
DB_TIER=db-custom-1-3840
DB_AVAILABILITY=REGIONAL

# Game service instances: at least 1 always running (no cold starts), at most this many under load.
GAME_MAX_INSTANCES=10

# Who gets the alerts ("deploy.sh alerts"): blocked rounds, edited odds or settings, payments that stop retrying or
# wait too long, measured RTP out of range or away from its target, wallet errors, the CDN, a busy database.
# Each alert goes to its owner's address (README, Monitoring and alerts); an owner left empty gets ALERT_EMAIL.
ALERT_EMAIL=oncall@example.com
# on-call engineer: integrity alarm, game stopped, database, CDN hit ratio
ALERT_EMAIL_ONCALL=
# the casino's wallet team: wallet error rate, payments waiting or no longer retried
ALERT_EMAIL_WALLET=
# finance / game operations: RTP (hard limits and against the target), blocked rounds not settled
ALERT_EMAIL_FINANCE=
# The wallet alert: failed wallet calls over this share of the rounds in 5 minutes, and at least this many of them.
# WALLET_ALERT_RATE=0.02
# WALLET_ALERT_MIN=5
# The RTP the odds are set for, in percent (e.g. 96.0): today's measured RTP more than RTP_TOLERANCE points away from it
# for 30 minutes, once there are RTP_ALERT_MIN_ROUNDS rounds today, alerts finance. Empty = that alert is not set up.
# Set the tolerance from the Monte Carlo spread of the boards in play (high-risk boards swing more).
TARGET_RTP=
# RTP_TOLERANCE=2
# RTP_ALERT_MIN_ROUNDS=50000
# The CDN alert: under this share of the static files served from Cloud CDN over an hour, with at least this many requests.
# CDN_ALERT_RATIO=0.95
# CDN_ALERT_MIN=1000

# The casino's time zone for Finance and daily totals (its days match its own books), e.g. Europe/Malta. Default UTC.
REPORTING_TIME_ZONE=UTC

# Retiring the original ROUND_SIGNING_KEY (README, Keys; e.g. after a leak): a UTC time such as 2026-11-01T00:00:00Z.
# From then on that key verifies only history made before it. Empty = not yet.
LEGACY_KEY_UNTIL=
# After a leak of ROUND_SIGNING_KEY (README, Keys): first LEGACY_RESIGN=false and deploy (stops signing old records again),
# then the time of the leak here: nothing made from then on is signed again with the current keys (it may be forged).
LEGACY_KEY_SUSPECTED_LEAK=
LEGACY_RESIGN=true

# Settling a blocked round (README; decision D10): the most a settlement may pay, per currency, and the most a payment
# that is not the round's own recomputed win may pay. Only initial values: empty = the platform currency at 1000 and 100; any other currency has no limit (and can't be paid or refunded) until one is set on the Settings page. E.g. EUR=1000,SEK=11000
SETTLEMENT_MAX_AMOUNTS=
SETTLEMENT_OTHER_AMOUNTS=

# Binary Authorization (README, "Image signing", review 7.7d): on by default: only images built and attested by
# "deploy.sh build" may run (the first build sets it up). "off" only for a throwaway test project.
BINAUTHZ=on
