# Copy to .env and fill in, or run ./scripts/generate-secrets.sh to create .env with random secrets.
# Never commit .env. Use long random values for every password, key and secret below.
# Containers are handed these secrets as files (Docker secrets) and refuse to start if one is missing or too short.

# Database (MySQL root, schema owner used for migrations, least-privilege app user)
MYSQL_ROOT_PASSWORD=
DB_OWNER_PASSWORD=
DB_PASSWORD=

# First admin account, created on first start. Left empty, its password is "admin": valid 24 hours, and the first
# sign-in must set up 2FA and choose a new password before anything else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs every round so stored outcomes cannot be edited unnoticed (64+ random characters).
ROUND_SIGNING_KEY=
# The keys per use (README, Keys) are files only: secrets/ROUND_KEYS, secrets/RECORD_KEYS, secrets/ENCRYPTION_KEYS
# ("id=secret,..." newest first; empty = ROUND_SIGNING_KEY). Retiring ROUND_SIGNING_KEY (README, Keys): from this UTC
# time on, it verifies only older history. Needs all three lists.
# LEGACY_KEY_UNTIL=2026-11-01T00:00:00Z
# After a leak of ROUND_SIGNING_KEY (README, Keys): first LEGACY_RESIGN=false (stops signing old records again), then the
# time of the leak here: nothing made from then on is signed again with the current keys (it may be forged).
# LEGACY_KEY_SUSPECTED_LEAK=2026-11-01T00:00:00Z
# LEGACY_RESIGN=true

# Settling a blocked round (README): limits per currency, e.g. EUR=1000,SEK=11000. Only initial values: empty = the platform currency at 1000 and 100; any other currency has no limit (and can't be paid or refunded) until one is set on the Settings page.
# SETTLEMENT_MAX_AMOUNTS=
# SETTLEMENT_OTHER_AMOUNTS=

# Wallet connection: the values from your PAM.
PAM_BASE_URL=https://pam.example.com/wallet
PAM_API_KEY=
PAM_SECRET=
# Only for a PAM on the same private network; otherwise PAM_BASE_URL must be https://
# PAM_ALLOW_HTTP=false

# Local testing only: set MOCK_PAM_ENABLED=true and PAM_BASE_URL=http://localhost:8080/mock-pam
MOCK_PAM_ENABLED=false
# Local testing on a phone (mock PAM only): the game's address on your network, for the QR codes on Admin -> Mock PAM
# MOCK_PHONE_GAME_URL=http://192.168.1.4:8080/
REQUIRE_SECOND_APPROVER=true
# Keep true behind HTTPS. Set false only to use the admin panel over plain http://127.0.0.1.
COOKIE_SECURE=true
GAME_URL=http://localhost:8080/
